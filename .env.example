# Generate local credentials with: python scripts/init_env.py
API_KEY=replace-with-generated-local-demo-key
INTERNAL_KEY=replace-with-generated-local-internal-key
POSTGRES_PASSWORD=replace-with-generated-database-password
MODEL_MODE=mock
CHAT_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
EMBEDDING_SIGNATURE=mock:featurehash-v1
AI_CONCURRENCY=1
QUEUE_CAPACITY=16
INGEST_CONCURRENCY=1
INGEST_QUEUE_CAPACITY=4
JOB_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=600
OLLAMA_BASE_URL=http://host.docker.internal:11434

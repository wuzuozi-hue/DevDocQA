# Export these before starting docqa_backend. The process does not read .env files.
API_KEY=replace-with-a-local-api-key-at-least-16-chars
INTERNAL_KEY=replace-with-an-internal-key-at-least-16-chars
PG_DSN=host=127.0.0.1 port=5432 dbname=docqa user=docqa password=docqa
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
AI_SERVICE_URL=http://127.0.0.1:8000
DATA_DIR=data/documents
DOCQA_PORT=8080
AI_CONCURRENCY=1
QUEUE_CAPACITY=16
INGEST_CONCURRENCY=1
INGEST_QUEUE_CAPACITY=4
JOB_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=600
MODEL_SIGNATURE=mock:featurehash-v1;extractive-v1;chunk-v1
EMBEDDING_SIGNATURE=mock:featurehash-v1
